# Neon PostgreSQL connection string (Neon dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Anthropic API key (console.anthropic.com > API keys). Never commit the real one.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Model used for every AI call. Haiku is the cheapest; switch to claude-sonnet-5-5 for better writing.
ANTHROPIC_MODEL=claude-haiku-5-5

# Set to 1 to use canned AI answers (no API key needed, no cost). Handy for demos and UI work.
AI_MOCK=0

# Default number of AI requests each business owner can make per day (Lagos time)
DAILY_AI_LIMIT=30
